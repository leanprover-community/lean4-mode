;;; lean4-test-helper.el --- Helpers for the Lean4-Mode test suite  -*- lexical-binding: t; -*-

;; SPDX-License-Identifier: Apache-2.0

;;; Commentary:

;; Helpers shared by the test files in this directory.
;;
;; The suite "make check" runs is hermetic: nothing in it starts a
;; language server, opens a network connection, or needs a Lean
;; toolchain.  Tests which need data from a server build it with
;; `lean4-test-payload' instead, and tests which need lsp-mode buffer
;; state stub it with `lean4-test-with-lsp'.
;;
;; The exception is lean4-live-*-test.el, which drives a real
;; "lean --server" and is held back for "make test-live".  It uses
;; these helpers too, so nothing here may assume there is no server.

;;; Code:

(require 'cl-lib)
(require 'ert)
(require 'json)
(require 'lean4-mode)

(defconst lean4-test-point-marker "-!-"
  "String replaced by point in `lean4-test-with-buffer' fixtures.
Fixtures which need this marker must not otherwise contain it.")

(defun lean4-test-payload (json)
  "Parse JSON into the object representation lsp-mode was built for.
Tests must not write object literals: lsp-mode picks between hash
tables and plists at compile time, from the LSP_USE_PLISTS environment
variable, and the accessors generated by `lsp-interface' only
understand whichever representation it was built for.  Going through
JSON keeps fixtures readable and correct under either setting."
  (if (bound-and-true-p lsp-use-plists)
      (json-parse-string json :object-type 'plist
                         :null-object nil :false-object nil)
    (json-parse-string json :object-type 'hash-table
                       :null-object nil :false-object nil)))

(defun lean4-test-object (object)
  "Build an LSP object from OBJECT, a plist in `json-serialize' form.
Use this for fixtures with values computed by the test; use
`lean4-test-payload' for payloads captured verbatim from a server."
  (lean4-test-payload (json-serialize object)))

(defmacro lean4-test-with-file-buffer (path &rest body)
  "Evaluate BODY in a buffer which reports PATH as its file name.
The buffer does not actually visit PATH, which keeps `auto-mode-alist'
and the mode hooks out of the way, but `buffer-file-name' and anything
derived from it behave as though it did."
  (declare (indent 1) (debug (form body)))
  `(let ((lean4-test--buffer (generate-new-buffer " *lean4-test-file*")))
     (unwind-protect
         (with-current-buffer lean4-test--buffer
           (setq buffer-file-name ,path)
           ,@body)
       (with-current-buffer lean4-test--buffer
         (set-buffer-modified-p nil))
       (kill-buffer lean4-test--buffer))))

(defmacro lean4-test-with-buffer (content &rest body)
  "Evaluate BODY in a temporary `lean4-mode' buffer containing CONTENT.
Point is left where `lean4-test-point-marker' appears in CONTENT, or at
the beginning of the buffer when the marker is absent.

`lean4-mode-hook' is suppressed, because it runs `lsp' by default and a
test must never start a language server."
  (declare (indent 1) (debug (form body)))
  `(with-temp-buffer
     (let ((lean4-mode-hook nil))
       (lean4-mode))
     (insert ,content)
     (goto-char (point-min))
     (if (search-forward lean4-test-point-marker nil t)
         (delete-char (- (length lean4-test-point-marker)))
       (goto-char (point-min)))
     ,@body))

(defun lean4-test-fontify ()
  "Fontify the whole buffer, for tests which inspect `face' properties."
  (font-lock-mode 1)
  (font-lock-ensure))

(defun lean4-test-face-at (string &optional occurrence)
  "Return the `face' property at the start of STRING in the current buffer.
Look at the OCCURRENCE-th match, counting from one, which defaults to
the first.  Fontify the buffer first, so that callers need not."
  (lean4-test-fontify)
  (save-excursion
    (goto-char (point-min))
    (search-forward string nil nil (or occurrence 1))
    (get-text-property (match-beginning 0) 'face)))

(defmacro lean4-test-with-directory (var spec &rest body)
  "Bind VAR to a temporary directory populated per SPEC, then run BODY.
SPEC evaluates to a list of relative file names.  Each is created as an
empty file, along with any directories leading to it.  VAR is bound to
the root of the tree, with a trailing slash.  The tree is removed
afterwards, even if BODY exits non-locally."
  (declare (indent 2) (debug (symbolp form body)))
  `(let ((,var (file-name-as-directory
                (make-temp-file "lean4-test" 'directory))))
     (unwind-protect
         (progn
           (dolist (file ,spec)
             (let ((path (expand-file-name file ,var)))
               (make-directory (file-name-directory path) t)
               (write-region "" nil path nil 'silent)))
           ,@body)
       (delete-directory ,var t))))

(defmacro lean4-test-with-lsp (line diagnostics &rest body)
  "Evaluate BODY with lsp-mode's buffer state stubbed out.
`lsp--cur-line' reports LINE and `lsp--get-buffer-diagnostics' reports
DIAGNOSTICS, both zero-based as on the wire.  This is what lets the
info view be rendered with no server attached."
  (declare (indent 2) (debug (form form body)))
  `(cl-letf (((symbol-function 'lsp--cur-line)
              (lambda (&rest _) ,line))
             ((symbol-function 'lsp--get-buffer-diagnostics)
              (lambda (&rest _) ,diagnostics)))
     ,@body))

(defmacro lean4-test-with-info-buffer (&rest body)
  "Evaluate BODY with a fresh *Lean Goal* buffer on display.
`lean4-goals' and `lean4-term-goal' start out nil, so that a test never
sees state left behind by its predecessors.  The info buffer is killed
afterwards."
  (declare (indent 0) (debug body))
  `(let ((lean4-goals nil)
         (lean4-term-goal nil))
     (unwind-protect
         (save-window-excursion
           (lean4-ensure-info-buffer lean4-info-buffer-name)
           (display-buffer lean4-info-buffer-name)
           ,@body)
       (when (get-buffer lean4-info-buffer-name)
         (kill-buffer lean4-info-buffer-name)))))

(defmacro lean4-test-with-active-info-buffer (source &rest body)
  "Evaluate BODY with buffer SOURCE current and the info view on display.
This is the state `lean4-info-buffer-active' insists on: the info
buffer visible in some window, and SOURCE the buffer of the selected
window.  Code gated on it is otherwise a silent no-op in a test."
  (declare (indent 1) (debug (form body)))
  `(lean4-test-with-info-buffer
     (save-window-excursion
       (delete-other-windows)
       (switch-to-buffer ,source)
       (display-buffer lean4-info-buffer-name)
       (should (lean4-info-buffer-active lean4-info-buffer-name))
       ,@body)))

(defmacro lean4-test-with-source-buffer (path content &rest body)
  "Evaluate BODY in a `lean4-mode' buffer holding CONTENT and named PATH.
Point starts at the beginning.  Unlike `lean4-test-with-buffer' the
buffer reports a file name, which is what the lsp-mode entry points
need in order to build a URI."
  (declare (indent 2) (debug (form form body)))
  `(let ((lean4-test--buffer (generate-new-buffer " *lean4-test-source*")))
     (unwind-protect
         (with-current-buffer lean4-test--buffer
           (let ((lean4-mode-hook nil))
             (lean4-mode))
           (setq buffer-file-name ,path)
           (insert ,content)
           (goto-char (point-min))
           ,@body)
       (with-current-buffer lean4-test--buffer
         (set-buffer-modified-p nil))
       (kill-buffer lean4-test--buffer))))

(defun lean4-test-info-text ()
  "Return the text of the *Lean Goal* buffer, without text properties."
  (with-current-buffer lean4-info-buffer-name
    (buffer-substring-no-properties (point-min) (point-max))))

(defun lean4-test-wait (predicate &optional timeout)
  "Pump timers until PREDICATE returns non-nil, or TIMEOUT seconds pass.
TIMEOUT defaults to two seconds.  Return what PREDICATE last returned,
so that a caller can `should' on it.  Batch Emacs runs no command loop,
so code scheduled with `run-at-time' only gets a chance to run inside a
wait such as this one."
  (let ((deadline (+ (float-time) (or timeout 2))))
    (while (and (not (funcall predicate))
                (< (float-time) deadline))
      (accept-process-output nil 0.01))
    (funcall predicate)))

(provide 'lean4-test-helper)
;;; lean4-test-helper.el ends here
